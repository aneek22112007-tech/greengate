{
  "name": "@greengate/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GreenGate News Reader. The heavy feature is an AI summary that Flagsmith can set to full, eco, or off.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
