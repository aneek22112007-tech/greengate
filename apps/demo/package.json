    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.2.0",
    "@greengate/flagsmith": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "tsx": "^4.20.6"
  }
}
