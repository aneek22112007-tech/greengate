# Copy to .env. Never commit .env. Values below are placeholders.

# Flagsmith (self-hosted). Dashboard: http://localhost:8100
FLAGSMITH_API_URL=http://localhost:8100/api/v1/
FLAGSMITH_EVENTS_URL=http://localhost:8100/api/
FLAGSMITH_ENVIRONMENT_KEY_DEVELOPMENT=ser.replace-me
FLAGSMITH_ENVIRONMENT_KEY_PRODUCTION=ser.replace-me
FLAGSMITH_CLIENT_KEY_DEVELOPMENT=replace-me
FLAGSMITH_CLIENT_KEY_PRODUCTION=replace-me
FLAGSMITH_ORGANISATION_API_KEY=replace-me
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID_DEVELOPMENT=
FLAGSMITH_ADMIN_EMAIL=greengate-admin@example.com
FLAGSMITH_ADMIN_PASSWORD=replace-me

# Electricity Maps carbon-intensity level. Leave empty to use the simulated provider.
ELECTRICITY_MAPS_TOKEN=
GREENGATE_MOCK_LEVEL=
GREENGATE_DEFAULT_ZONE=IN-SO
GREENGATE_MAPPING=strict

# Optional OpenAI-compatible summaries. Empty uses the local extractive stand-in.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Optional. The demo uses this zone when force-level is off and no other zone resolves.
GREENGATE_ZONE=

NODE_ENV=development
PORT=3000

# Optional. Bootstrap and the experiment scripts default to http://localhost:8100.
FLAGSMITH_BASE_URL=http://localhost:8100

# Optional. The simulator defaults to the local demo and 2000 users.
DEMO_URL=http://localhost:3000
GREENGATE_SIM_USERS=2000
GREENGATE_SIM_CONCURRENCY=12
